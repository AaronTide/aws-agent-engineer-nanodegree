{
    "nodes": [
        {
            "name": "FlowInputNode",
            "type": "Input",
            "configuration": {
                "input": {}
            },
            "outputs": [
                {
                    "name": "document",
                    "type": "String"
                }
            ]
        },
        {
            "name": "InputPrompt",
            "type": "Prompt",
            "configuration": {
                "prompt": {
                    "sourceConfiguration": {
                        "inline": {
                            "templateType": "TEXT",
                            "templateConfiguration": {
                                "text": {
                                    "text": "Classify an input customer message as one of the following:\n* BUG_REPORT - if user is reporting a bug\n* PRODUCT_QUESTION - if there is a question about Amazon Well-Architected Framework\n* OTHER_RELATED - if it is another customer support question\n* UNRELATED - if it is an unrelated question\nCustomer message:\n```\n{{customer_message}}\n```\nReturn just one of the following:\n\n* BUG_REPORT\n* PRODUCT_QUESTION\n* OTHER_RELATED\n* UNRELATED\n\nDo not write anything else.",
                                    "inputVariables": [
                                        {
                                            "name": "customer_message"
                                        }
                                    ]
                                }
                            },
                            "modelId": "arn:aws:bedrock:us-east-1:<account-id>:inference-profile/us.amazon.nova-premier-v1:0",
                            "inferenceConfiguration": {
                                "text": {
                                    "temperature": 0.699999988079071,
                                    "topP": 0.8999999761581421,
                                    "maxTokens": 512,
                                    "stopSequences": []
                                }
                            }
                        }
                    }
                }
            },
            "inputs": [
                {
                    "name": "customer_message",
                    "type": "String",
                    "expression": "$.data"
                }
            ],
            "outputs": [
                {
                    "name": "modelCompletion",
                    "type": "String"
                }
            ]
        },
        {
            "name": "OtherRequestsOutputNode",
            "type": "Output",
            "configuration": {
                "output": {}
            },
            "inputs": [
                {
                    "name": "document",
                    "type": "String",
                    "expression": "$.data"
                }
            ]
        },
        {
            "name": "InputClassifier",
            "type": "Condition",
            "configuration": {
                "condition": {
                    "conditions": [
                        {
                            "name": "is_bug",
                            "expression": "conditionInput == \"BUG_REPORT\""
                        },
                        {
                            "name": "is_product_question",
                            "expression": "conditionInput == \"PRODUCT_QUESTION\""
                        },
                        {
                            "name": "Condition1",
                            "expression": "conditionInput == \"OTHER_RELATED\""
                        },
                        {
                            "name": "default"
                        }
                    ]
                }
            },
            "inputs": [
                {
                    "name": "conditionInput",
                    "type": "String",
                    "expression": "$.data"
                }
            ]
        },
        {
            "name": "OtherRequests",
            "type": "Prompt",
            "configuration": {
                "prompt": {
                    "sourceConfiguration": {
                        "inline": {
                            "templateType": "TEXT",
                            "templateConfiguration": {
                                "text": {
                                    "text": "User has sent a customer request:\n```\n{{customer_request}}\n```\nUnfortunatetly, we cannot process them automatically.\nReply with a message politely explaining that they would have to call phone number +12345678 for support team to help with this request.\nDo not write anything else. Your output will be sent to a user directly.",
                                    "inputVariables": [
                                        {
                                            "name": "customer_request"
                                        }
                                    ]
                                }
                            },
                            "modelId": "arn:aws:bedrock:us-east-1:<account-id>:inference-profile/us.amazon.nova-premier-v1:0",
                            "inferenceConfiguration": {
                                "text": {
                                    "temperature": 0.699999988079071,
                                    "topP": 0.8999999761581421,
                                    "maxTokens": 512,
                                    "stopSequences": []
                                }
                            }
                        }
                    }
                }
            },
            "inputs": [
                {
                    "name": "customer_request",
                    "type": "String",
                    "expression": "$.data"
                }
            ],
            "outputs": [
                {
                    "name": "modelCompletion",
                    "type": "String"
                }
            ]
        },
        {
            "name": "BugReportOutputNode",
            "type": "Output",
            "configuration": {
                "output": {}
            },
            "inputs": [
                {
                    "name": "document",
                    "type": "String",
                    "expression": "$.data"
                }
            ]
        },
        {
            "name": "BugDataCollector",
            "type": "Agent",
            "configuration": {
                "agent": {
                    "agentAliasArn": "arn:aws:bedrock:us-east-1:<account-id>:agent-alias/8086PZGUEW/TSTALIASID"
                }
            },
            "inputs": [
                {
                    "name": "agentInputText",
                    "type": "String",
                    "expression": "$.data"
                },
                {
                    "name": "promptAttributes",
                    "type": "Object",
                    "expression": "$.data"
                },
                {
                    "name": "sessionAttributes",
                    "type": "Object",
                    "expression": "$.data"
                }
            ],
            "outputs": [
                {
                    "name": "agentResponse",
                    "type": "String"
                }
            ]
        },
        {
            "name": "BugReportCreator",
            "type": "Agent",
            "configuration": {
                "agent": {
                    "agentAliasArn": "arn:aws:bedrock:us-east-1:<account-id>:agent-alias/29JDSSSBOA/TSTALIASID"
                }
            },
            "inputs": [
                {
                    "name": "agentInputText",
                    "type": "String",
                    "expression": "$.data"
                },
                {
                    "name": "promptAttributes",
                    "type": "Object",
                    "expression": "$.data"
                },
                {
                    "name": "sessionAttributes",
                    "type": "Object",
                    "expression": "$.data"
                }
            ],
            "outputs": [
                {
                    "name": "agentResponse",
                    "type": "String"
                }
            ]
        },
        {
            "name": "KnowledgeBaseNode",
            "type": "KnowledgeBase",
            "configuration": {
                "knowledgeBase": {
                    "knowledgeBaseId": "6IJMLSQG5O"
                }
            },
            "inputs": [
                {
                    "name": "retrievalQuery",
                    "type": "String",
                    "expression": "$.data"
                }
            ],
            "outputs": [
                {
                    "name": "retrievalResults",
                    "type": "Array"
                }
            ]
        },
        {
            "name": "KnowledgeBaseOutputNode",
            "type": "Output",
            "configuration": {
                "output": {}
            },
            "inputs": [
                {
                    "name": "document",
                    "type": "String",
                    "expression": "$.data"
                }
            ]
        },
        {
            "name": "AggregateKnowledgeBase",
            "type": "Prompt",
            "configuration": {
                "prompt": {
                    "sourceConfiguration": {
                        "inline": {
                            "templateType": "TEXT",
                            "templateConfiguration": {
                                "text": {
                                    "text": "You are a helpful online assistant. You will receive a customer request, and output from a Knowledge Base.\n\nIf the output from the Knowledge Base answers user's question, summarize it and provide a helpful response to a user.\n\nIf the output does not replies to the user's question, suggest you can't answer it and suggest to call +12345678.\n\nUser's question:\n\n```\n{{customer_message}}\n```\n\nSearch result from Knowledge Base:\n\n```\n{{kb_output}}\n```",
                                    "inputVariables": [
                                        {
                                            "name": "customer_message"
                                        },
                                        {
                                            "name": "kb_output"
                                        }
                                    ]
                                }
                            },
                            "modelId": "arn:aws:bedrock:us-east-1:<account-id>:inference-profile/us.amazon.nova-premier-v1:0",
                            "inferenceConfiguration": {
                                "text": {
                                    "temperature": 0.699999988079071,
                                    "topP": 0.8999999761581421,
                                    "maxTokens": 512,
                                    "stopSequences": []
                                }
                            }
                        }
                    }
                }
            },
            "inputs": [
                {
                    "name": "customer_message",
                    "type": "String",
                    "expression": "$.data"
                },
                {
                    "name": "kb_output",
                    "type": "Array",
                    "expression": "$.data"
                }
            ],
            "outputs": [
                {
                    "name": "modelCompletion",
                    "type": "String"
                }
            ]
        },
        {
            "name": "UnrelatedQuestionOutputNode",
            "type": "Output",
            "configuration": {
                "output": {}
            },
            "inputs": [
                {
                    "name": "document",
                    "type": "String",
                    "expression": "$.data"
                }
            ]
        },
        {
            "name": "UnrelatedQuestion",
            "type": "Prompt",
            "configuration": {
                "prompt": {
                    "sourceConfiguration": {
                        "inline": {
                            "templateType": "TEXT",
                            "templateConfiguration": {
                                "text": {
                                    "text": "You are a helpful customer support agent, but you've received an unrelated question. Politely reply that you cannot help with this question.",
                                    "inputVariables": []
                                }
                            },
                            "modelId": "amazon.nova-pro-v1:0",
                            "inferenceConfiguration": {
                                "text": {
                                    "temperature": 0.699999988079071,
                                    "topP": 0.8999999761581421,
                                    "maxTokens": 512,
                                    "stopSequences": []
                                }
                            }
                        }
                    }
                }
            },
            "outputs": [
                {
                    "name": "modelCompletion",
                    "type": "String"
                }
            ]
        }
    ],
    "connections": [
        {
            "type": "Data",
